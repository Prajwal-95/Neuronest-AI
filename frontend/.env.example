# Copy to `.env` when you enable Google sign-in.
# The Login page shows "Continue with Google" only when this AND the backend
# GOOGLE_CLIENT_ID are set (they must be the same Client ID).
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Production API URL (Render). Leave empty for local dev (Vite proxy is used).
# On Render static site set: VITE_API_URL=https://<your-api>.onrender.com
VITE_API_URL=