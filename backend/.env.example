# ============================================================================
# NeuroNest AI  --  backend configuration
# Copy to `.env` and edit. Every value has a working default, so an empty
# `.env` still runs the app on the local SQLite database.
#
# Verify any change with:
#   cd backend
#   ..\venv\Scripts\python.exe scripts\supabase_setup.py --check
# ============================================================================

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave DATABASE_URL unset to use the built-in SQLite default, which resolves
# to backend/neuronest.db relative to THIS FILE rather than the process working
# directory. A relative value here (sqlite:///./neuronest.db) is resolved
# against the CWD, so launching uvicorn from the repo root silently created a
# second, empty database and every demo login failed.
#
# For a non-Supabase PostgreSQL, set an absolute URL instead:
# DATABASE_URL=postgresql://user:pass@localhost:5432/neuronest
#
# Note: USE_SUPABASE=true (below) takes priority over DATABASE_URL.

# ---------------------------------------------------------------------------
# Supabase  (optional - required for the hosted deployment)
# Full walkthrough: docs/SUPABASE_SETUP.md
# ---------------------------------------------------------------------------
# 1. Turn it on. While this is false the app uses DATABASE_URL / SQLite and
#    every setting below is ignored.
USE_SUPABASE=false

# 2. Project API keys. Dashboard -> Project Settings -> API.
#    Only needed for Storage/Realtime and the /health/supabase probe.
#    Supabase renamed keys in 2025: use EITHER naming, whichever your dashboard shows.
#      publishable  == old "anon public"      -> safe-ish, respects RLS
#      secret       == old "service_role"     -> BYPASSES RLS, backend only, never frontend
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Never ship the secret/service_role key to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# SUPABASE_SECRET_KEY=your-supabase-secret-key

# 3. Database credentials. Dashboard -> Project Settings -> Database.
#    SUPABASE_DB_PASSWORD is the DATABASE password you chose when the project
#    was created. It is NOT the anon key and NOT the service_role key.
SUPABASE_DB_PASSWORD=your-supabase-db-password

#    Easiest: paste only the project ref and the host is derived as
#    db.<ref>.supabase.co
SUPABASE_PROJECT_REF=your-project-ref

#    Or paste the host straight from the "Connection string" panel:
#      * SESSION POOLER  -> port 5432, best for a long-running server
#      * TRANSACTION POOLER -> port 6543, best for serverless
#    The tenant-qualified role (postgres.<ref>) is derived automatically on
#    port 6543, so you do not have to remember it.
# SUPABASE_DB_HOST=aws-0-ap-south-1.pooler.supabase.com
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_USER=postgres

SUPABASE_DB_NAME=postgres
SUPABASE_SSL_MODE=require
# SUPABASE_POOLER=false
# SUPABASE_STORAGE_BUCKET=neuronest-uploads

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google sign-in (optional). The Login page shows "Continue with Google" only
# when BOTH this and the frontend VITE_GOOGLE_CLIENT_ID are set to the same
# value from Google Cloud Console -> APIs & Services -> Credentials ->
# OAuth client ID (type: Web application).
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# First-time Google users pick patient/caregiver on the Login page; this is
# only the fallback when no role is sent.
# GOOGLE_DEFAULT_ROLE=patient
# Restrict Google sign-in to invited accounts (comma-separated). Empty = anyone
# with a valid Google account may sign in.
# GOOGLE_ALLOWED_EMAILS=you@example.com,family@example.com

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Local dev defaults. For Render production, set to your frontend URL(s),
# comma-separated, e.g. CORS_ORIGINS=https://neuronest-app.onrender.com
# A single URL (no brackets) is also accepted.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---------------------------------------------------------------------------
# Connection pool (ignored by SQLite)
# ---------------------------------------------------------------------------
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE_SECONDS=300
# DB_CONNECT_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# Health endpoints
# ---------------------------------------------------------------------------
# Include per-table row counts in /health/database. Off by default because that
# endpoint is unauthenticated.
HEALTH_EXPOSE_COUNTS=false

# ---------------------------------------------------------------------------
# Google login (optional - "Continue with Google" button)
# ---------------------------------------------------------------------------
# 1. Google Cloud Console -> APIs & Services -> Credentials -> Create
#    Credentials -> OAuth client ID (type: Web application). Add
#    http://localhost:5173 under Authorised JavaScript origins.
# 2. Paste the SAME client id in backend/.env AND frontend/.env.
#    The Login button appears only when both are set.
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# First-time Google users pick patient/caregiver on the Login page; this is
# only the fallback when no role is sent.
# GOOGLE_DEFAULT_ROLE=patient
# Invite-only pilot? List the allowed Google accounts (comma-separated).
# Empty = any valid Google account may sign in.
# GOOGLE_ALLOWED_EMAILS=you@example.com,family@example.com

